# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=smart_sales_analyzer

# JWT — replace with random 32+ character string
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173"]

# Spark
SPARK_HOME=C:\spark
SPARK_SUBMIT=C:\spark\bin\spark-submit.cmd
SPARK_JAR=..\spark-engine\target\scala-2.12\smart-sales-analyzer-spark-assembly-1.0.0.jar
SPARK_TIMEOUT_SECONDS=300

# Upload limits
MAX_FILE_SIZE_MB=50
MAX_ROWS=500000

# Temp directory for Spark job files
TEMP_DIR=temp_jobs
